{
  "name": "ticketing-platform",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "scripts": {
    "build": "npm --workspace apps/web run build",
    "dev": "npm --workspace apps/web run dev",
    "db:generate": "npm --workspace apps/web run db:generate",
    "db:migrate:deploy": "npm --workspace apps/web run db:migrate:deploy",
    "db:seed": "npm --workspace apps/web run db:seed"
  },
  "devDependencies": {
    "prisma": "^5.20.0"
  },
  "overrides": {
    "@types/react": "18.3.27",
    "@types/react-dom": "18.3.1",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "lucide-react": "^0.563.0"
  }
}
