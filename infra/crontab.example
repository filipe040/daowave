# =============================================================================
# Crontab LivePass — VPS com PM2 + Nginx (NÃO usar Vercel Cron)
#
# Instalação:
#   1. Define CRON_SECRET no apps/web/.env (mesmo valor que a app usa)
#   2. Ajusta LIVEPASS_ROOT e APP_BASE_URL abaixo
#   3. crontab -e  e cola as linhas (sem os comentários de cabeçalho se preferires)
#
# Nota: APP_BASE_URL pode ser http://127.0.0.1:3000 (directo ao PM2)
#       ou https://teu-dominio.pt (via Nginx)
# =============================================================================

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin

# Ajustar estes valores:
LIVEPASS_ROOT=/var/www/daowave/daowave
APP_BASE_URL=http://127.0.0.1:3000

# Libertar reservas de stock expiradas — cada 2 minutos
*/2 * * * * cd $LIVEPASS_ROOT && APP_BASE_URL=$APP_BASE_URL ./scripts/cron-runner.sh release-holds >> /var/log/livepass-cron.log 2>&1

# Alertas de bilhetes (pré-registo) — cada 5 minutos
*/5 * * * * cd $LIVEPASS_ROOT && APP_BASE_URL=$APP_BASE_URL ./scripts/cron-runner.sh ticket-alerts >> /var/log/livepass-cron.log 2>&1

# Emails agendados (lembretes 24h, thank-you, relatórios) — cada hora
0 * * * * cd $LIVEPASS_ROOT && APP_BASE_URL=$APP_BASE_URL ./scripts/cron-runner.sh email-schedulers >> /var/log/livepass-cron.log 2>&1

# Libertar saldos financeiros (PENDING → AVAILABLE) — diário às 02:00
0 2 * * * cd $LIVEPASS_ROOT && APP_BASE_URL=$APP_BASE_URL ./scripts/cron-runner.sh release-balances >> /var/log/livepass-cron.log 2>&1

# Liquidações automáticas promotores — diário às 03:00
0 3 * * * cd $LIVEPASS_ROOT && APP_BASE_URL=$APP_BASE_URL ./scripts/cron-runner.sh auto-settlements >> /var/log/livepass-cron.log 2>&1

# Cancelar encomendas PENDING abandonadas — cada 15 minutos
*/15 * * * * cd $LIVEPASS_ROOT && APP_BASE_URL=$APP_BASE_URL ./scripts/cron-runner.sh expire-orders >> /var/log/livepass-cron.log 2>&1
