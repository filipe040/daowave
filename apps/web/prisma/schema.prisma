generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                              String    @id @default(uuid())
  name                            String?
  avatarUrl                       String?
  email                           String    @unique
  passwordHash                    String
  role                            Role      @default(USER)
  emailVerified                   Boolean   @default(false)
  emailVerificationToken          String?   @unique
  emailVerificationTokenExpiresAt DateTime?
  createdAt                       DateTime  @default(now())
  // Password reset
  passwordResetToken              String?   @unique
  passwordResetTokenExpiresAt     DateTime?
  
  orders              Order[]
  tickets             Ticket[]
  promoterProfile      PromoterProfile?
  validatorCheckins    CheckinLog[]      @relation("ValidatorCheckins")
  transferFromUser     TransferLog[]      @relation("TransferFromUser")
  transferToUser       TransferLog[]      @relation("TransferToUser")
  eventTeamMembers     EventTeamMember[]
  
  @@index([email])
  @@index([emailVerificationToken])
}

enum OrganizerStatus {
  PENDING
  APPROVED
  REJECTED
}

model PromoterProfile {
  id          String          @id @default(uuid())
  userId      String          @unique
  brandName   String
  vatNumber   String?
  status      OrganizerStatus @default(PENDING)
  contactEmail String?
  createdAt   DateTime        @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  events      Event[]
  
  @@index([userId])
}

model Event {
  id          String      @id @default(uuid())
  promoterId  String
  title       String
  slug        String       @unique
  description String
  venue       String
  city        String
  startAt     DateTime
  endAt       DateTime
  coverImage  String?
  status      EventStatus  @default(DRAFT)
  archivedAt  DateTime?    // Data de arquivamento (null = não arquivado)
  createdAt   DateTime     @default(now())
  // Branding & Visual Protocol (Editor de Marca)
  primaryColor        String?  // Cor primária da marca do evento
  secondaryColor      String?  // Cor secundária da marca do evento
  logoUrl             String?  // URL do logo do evento
  bannerUrl           String?  // URL do banner/header do evento
  fontFamily          String?  // Fonte personalizada (ex: "Inter", "Roboto")
  // Landing Page customizada
  landingPageContent  String?  @db.Text // HTML/JSON do conteúdo da landing page customizada
  useCustomLandingPage Boolean @default(false) // Se deve usar landing page customizada
  // Badge Designer (Template PDF do bilhete)
  badgeTemplateImageUrl String? // URL da imagem template do badge/bilhete PDF
  badgePrefix           String? @default("BADGE") // Prefixo para IDs dos badges gerados
  // Check-in configuration
  checkinMode           String?  @default("SINGLE") // SINGLE, MULTI
  checkinStartAt        DateTime? // Início da janela de check-in
  checkinEndAt          DateTime? // Fim da janela de check-in
  maxEntries            Int?     // Máximo de entradas por bilhete (MULTI mode)

  promoter    PromoterProfile @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  ticketLots   TicketLot[]
  orders      Order[]
  tickets     Ticket[]
  checkinLogs CheckinLog[]
  teamMembers EventTeamMember[]
  coupons     Coupon[]
  assets      EventAsset[]
  
  @@index([slug])
  @@index([status])
  @@index([promoterId])
}

model TicketLot {
  id            String   @id @default(uuid())
  eventId       String
  name          String
  priceCents    Int
  currency      String   @default("EUR")
  quantityTotal Int
  quantitySold  Int      @default(0)
  saleStartAt   DateTime
  saleEndAt     DateTime
  createdAt     DateTime @default(now())
  
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  tickets       Ticket[]
  
  @@index([eventId])
}

model Order {
  id             String      @id @default(uuid())
  userId         String
  eventId        String
  totalCents      Int
  currency        String      @default("EUR")
  status          OrderStatus @default(PENDING)
  paymentProvider String?
  paymentRef      String?
  createdAt       DateTime    @default(now())
  
  user            User        @relation(fields: [userId], references: [id])
  event           Event       @relation(fields: [eventId], references: [id])
  items           OrderItem[]
  tickets         Ticket[]
  
  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@index([paymentRef])
}

model OrderItem {
  id          String    @id @default(uuid())
  orderId     String
  ticketLotId String
  quantity    Int
  unitPriceCents Int
  
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketLot   TicketLot @relation(fields: [ticketLotId], references: [id])
  
  @@index([orderId])
}

model Ticket {
  id          String   @id @default(uuid())
  orderId     String
  eventId     String
  userId      String
  ticketLotId String
  code        String   @unique
  qrPayload   String
  checkedInAt DateTime?
  checkedInByUserId String?
  createdAt   DateTime @default(now())
  // Check-in tracking (MULTI mode)
  entriesUsed Int      @default(0) // Número de entradas já utilizadas
  lastCheckinAt DateTime? // Última vez que foi usado
  
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event         Event        @relation(fields: [eventId], references: [id])
  user          User         @relation(fields: [userId], references: [id])
  ticketLot     TicketLot    @relation(fields: [ticketLotId], references: [id])
  checkinLogs   CheckinLog[]
  transferFrom  TransferLog?  @relation("TransferFrom")
  transferTo    TransferLog?  @relation("TransferTo")
  
  @@index([orderId])
  @@index([eventId])
  @@index([userId])
  @@index([ticketLotId])
  @@index([code])
}

model EmailLog {
  id                String    @id @default(uuid())
  to                String
  subject           String
  template          String?
  type              String?
  status            String    @default("PENDING")
  sentAt            DateTime?
  error             String?
  retryCount        Int       @default(0)
  providerMessageId String?
  relatedOrderId    String?
  relatedTicketId   String?
  relatedUserId     String?
  meta              Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([to])
  @@index([status])
  @@index([createdAt])
  @@index([type])
  @@index([relatedOrderId])
  @@index([relatedUserId])
}

model AuditLog {
  id          String   @id @default(uuid())
  actorUserId String?
  action      String
  entityType  String
  entityId    String?
  metaJson    Json?
  createdAt   DateTime @default(now())
  
  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum Role {
  USER
  PROMOTER
  ADMIN
}

enum EventStatus {
  DRAFT
  PUBLISHED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED
}

enum EventTeamRole {
  ADMIN      // Acesso total ao evento
  ORGANIZER  // Organizador principal
  MANAGER    // Gestor operacional
  STAFF      // Staff operacional
  VIEWER     // Apenas visualização
}

enum EventTeamPermission {
  CREATE_EVENTS     // Criar eventos
  SELL_TICKETS      // Vender bilhetes
  VALIDATE_ENTRIES  // Validar entradas
  VIEW_REPORTS      // Ver relatórios
  MANAGE_TEAMS      // Gerir equipas
}

model CheckinLog {
  id              String   @id @default(uuid())
  ticketId        String
  eventId         String
  validatorUserId String
  deviceId        String?
  result          String
  scannedAt       DateTime @default(now())
  rawPayloadHash  String
  offline         Boolean  @default(false)
  syncedAt        DateTime?
  
  ticket          Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  validator       User     @relation("ValidatorCheckins", fields: [validatorUserId], references: [id], onDelete: Restrict)
  
  @@index([ticketId])
  @@index([eventId])
  @@index([scannedAt])
  @@index([validatorUserId])
  @@index([offline, syncedAt])
}

model TransferLog {
  id           String   @id @default(uuid())
  fromTicketId String   @unique
  toTicketId   String   @unique
  fromUserId   String
  toUserId     String
  toEmail      String
  createdAt    DateTime @default(now())
  
  fromTicket   Ticket   @relation("TransferFrom", fields: [fromTicketId], references: [id], onDelete: Restrict)
  toTicket     Ticket   @relation("TransferTo", fields: [toTicketId], references: [id], onDelete: Restrict)
  fromUser     User     @relation("TransferFromUser", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser       User     @relation("TransferToUser", fields: [toUserId], references: [id], onDelete: Restrict)
  
  @@index([fromUserId])
  @@index([toUserId])
}

enum CouponDiscountType {
  PERCENTAGE  // Desconto percentual (1-100)
  FIXED       // Desconto fixo em cêntimos
}

model Coupon {
  id            String              @id @default(uuid())
  eventId       String
  code          String              @unique
  discountType  CouponDiscountType
  discountValue Int                 // Percentagem (1-100) ou valor em cêntimos
  maxUses       Int?                // Máximo de utilizações (null = ilimitado)
  usedCount     Int                 @default(0)
  isActive      Boolean             @default(true)
  startsAt      DateTime
  endsAt        DateTime
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @default(now()) @updatedAt
  
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  @@index([eventId])
  @@index([code])
  @@index([isActive])
  @@index([endsAt])
}

model EventAsset {
  id          String   @id @default(uuid())
  eventId     String
  filename    String
  name        String?
  url         String   // URL pública do asset (ex: /uploads/events/{eventId}/{filename})
  mimeType    String   // image/png, image/jpeg, etc.
  size        Int      // Tamanho em bytes
  createdAt   DateTime @default(now())
  
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  @@index([eventId])
  @@index([createdAt])
}

model EventTeamMember {
  id          String            @id @default(uuid())
  eventId     String
  userId      String
  role        EventTeamRole     @default(STAFF)
  isActive    Boolean           @default(true)
  isVolunteer Boolean           @default(false)
  notes       String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt
  lastAccessAt DateTime?
  
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions EventTeamMemberPermission[]
  
  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  @@index([role])
  @@index([isActive])
}

model EventTeamMemberPermission {
  id          String              @id @default(uuid())
  memberId    String
  permission  EventTeamPermission
  
  member      EventTeamMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  @@unique([memberId, permission])
  @@index([memberId])
  @@index([permission])
}