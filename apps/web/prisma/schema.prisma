generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                              String    @id @default(uuid())
  name                            String?
  avatarUrl                       String?   @db.VarChar(2048)
  email                           String    @unique
  passwordHash                    String?   // nullable for OAuth-only users
  role                            Role      @default(USER)
  emailVerified                   Boolean   @default(false)
  emailVerificationToken          String?   @unique
  onboardingComplete             Boolean   @default(false)
  locale                         String    @default("pt")
  createdAt                       DateTime  @default(now())
  // Password reset
  passwordResetToken              String?   @unique
  passwordResetTokenExpiresAt     DateTime?
  // Profile & preferences
  phone                           String?   @db.VarChar(32)
  emailVerifiedAt                 DateTime?
  lastLoginAt                     DateTime?
  termsAcceptedAt                 DateTime?
  termsVersion                    String?   @db.VarChar(32)
  marketingOptIn                  Boolean   @default(false)
  notifyEmail                     Boolean   @default(true)
  notifyEventReminders            Boolean   @default(true)
  notifyTransfers                 Boolean   @default(true)

  orders              Order[]
  tickets             Ticket[]
  promoterProfile      PromoterProfile? 
  organizations        OrganizationMember[]
  validatorCheckins    CheckinLog[]      @relation("ValidatorCheckins")
  transferFromUser     TransferLog[]      @relation("TransferFromUser")
  transferToUser       TransferLog[]      @relation("TransferToUser")
  eventTeamMembers     EventTeamMember[] 
  userSessions        UserSession[]
  fraudSignals        FraudSignal[]
  manualPaymentsReceived ManualPayment[]
  ticketAlerts        EventTicketAlert[]
  eventFavorites      EventFavorite[]

  accounts            Account[]

  @@index([email])
  @@index([emailVerificationToken])
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  ip         String?   @db.VarChar(45)
  userAgent  String?   @db.VarChar(512)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([revokedAt])
}

// OAuth provider accounts (Google, Apple)
model Account {
  id                String   @id @default(uuid())
  userId            String
  provider          String   // "google" | "apple"
  providerAccountId String   // sub from provider
  email             String?  @db.VarChar(512) // may be privaterelay for Apple HME
  accessToken       String?  @db.Text
  refreshToken      String?  @db.Text
  idToken           String?  @db.Text
  expiresAt         Int?
  createdAt         DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@index([provider, email])
}

// --- ORGANIZATION & RBAC ---

enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum MemberRole {
  PROMOTER_OWNER
  PROMOTER_MANAGER
  PROMOTER_FINANCE
  PROMOTER_CASHIER
  PROMOTER_CHECKIN
  READ_ONLY
}

model Organization {
  id           String             @id @default(uuid())
  name         String
  legalName    String?
  slug         String             @unique
  vatNumber    String?
  contactEmail String?
  phone        String?
  address      String?
  country      String?
  website      String?
  logoUrl      String?
  invoiceThemeJson Json?
  status       OrganizationStatus @default(PENDING)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  members      OrganizationMember[]
  events       Event[]
  payouts      Payout[]
  auditLogs    AuditLog[]
  invites      Invite[]
  wallet       Wallet?
  withdrawalRequests WithdrawalRequest[]
  ledgerTransactions LedgerTransaction[]
  promoterFinancialSettings PromoterFinancialSettings?
  financeCostEntries FinanceCostEntry[]
  feeCampaigns         FeeCampaign[]

  ticketTemplates      OrganizationTicketTemplate[]
  ticketTemplateAssets TicketTemplateAsset[]
  ticketSnapshots      TicketRenderSnapshot[]
  coupons              Coupon[]

  @@index([slug])
  @@index([status])
}

// --- TICKET DESIGN SYSTEM ---

enum TicketTemplateStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum TicketTemplateAssetType {
  LOGO
  BACKGROUND
  STAMP
}

model OrganizationTicketTemplate {
  id             String               @id @default(uuid())
  organizationId String
  name           String
  status         TicketTemplateStatus @default(DRAFT)
  preset         String               @default("default")
  themeJson      Json
  version        Int                  @default(1)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshots      TicketRenderSnapshot[]
  events         Event[]              @relation("EventTicketTemplate")

  @@index([organizationId])
  @@index([status])
  @@index([createdAt])
}

model TicketTemplateAsset {
  id             String                  @id @default(uuid())
  organizationId String
  type           TicketTemplateAssetType
  url            String                  @db.VarChar(2048)
  metaJson       Json?
  createdAt      DateTime                @default(now())

  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
}

model TicketRenderSnapshot {
  id                String   @id @default(uuid())
  ticketId          String   @unique
  organizationId    String
  templateId        String
  templateVersion   Int
  preset            String
  themeJson         Json
  htmlHash          String   // sha256 do HTML final
  pdfPath           String?  // opcional: path/cache local
  createdAt         DateTime @default(now())

  ticket            Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template          OrganizationTicketTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([organizationId])
  @@index([templateId])
  @@index([ticketId])
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           MemberRole   @default(PROMOTER_CHECKIN)
  status         String       @default("ACTIVE") // ACTIVE, INACTIVE, INVITED
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedCoupons Coupon[]
  couponCommissions CouponCommission[]

  @@unique([organizationId, userId])
  @@index([userId])
}

// Deprecated (Legacy Promoter)
model PromoterProfile {
  id           String          @id @default(uuid())
  userId       String          @unique
  brandName    String
  vatNumber    String?
  status       OrganizerStatus @default(PENDING)
  contactEmail String?
  score        Int?            // Score/reputação (admin); null = não calculado
  adminNotes   String?         @db.Text // Notas internas admin
  createdAt    DateTime        @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  events      Event[]
  payouts     Payout[]
  
  @@index([userId])
}
enum OrganizerStatus {
  PENDING
  APPROVED
  REJECTED
}

// --- ADVANCED TICKETING SYSTEM ---

enum TicketTypeStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

enum TicketLotStatus {
  ACTIVE
  PAUSED
  SOLD_OUT
  ARCHIVED
}

enum HoldStatus {
  ACTIVE
  RELEASED
  CONVERTED
}

enum SeatStatus {
  AVAILABLE
  SOLD
  BLOCKED
}

enum SeatMapType {
  THEATER
  TABLES
}

// --- EVENTS ---

model Event {
  id          String      @id @default(uuid())
  organizationId String?  // New relation
  promoterId  String      // Legacy relation (keep for migration)
  title       String
  slug        String       @unique
  description String      @db.Text
  venue       String
  city        String
  category    String?  // Género: Concertos, Teatro, Festivais, etc.
  locationUrl String?  @db.VarChar(2048) // Link Google Maps para o mapa na página pública
  startAt     DateTime
  endAt       DateTime
  coverImage  String?
  status      EventStatus  @default(DRAFT)
  archivedAt  DateTime?    // Data de arquivamento (null = não arquivado)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt @default(now())

  // Branding & Visual Protocol (Editor de Marca)
  primaryColor        String?  // Cor primária da marca do evento
  secondaryColor      String?  // Cor secundária da marca do evento
  logoUrl             String?  // URL do logo do evento
  bannerUrl           String?  // URL do banner/header do evento
  fontFamily           String?
  useCustomLandingPage Boolean  @default(false)
  landingPageContent   String?  @db.Text
  
  ticketTemplateId     String?  // Id do template de bilhetes especifico para este evento
  ticketTemplate       OrganizationTicketTemplate? @relation("EventTicketTemplate", fields: [ticketTemplateId], references: [id])
  invoiceThemeJson     Json?    // Override do design de faturas (herda da organização se null)
  
  // Check-in configuration
  checkinMode           String?  @default("SINGLE") // SINGLE, MULTI
  checkinStartAt        DateTime? // Início da janela de check-in
  checkinEndAt          DateTime? // Fim da janela de check-in

  layoutMode            EventLayoutMode @default(STANDARD)
  presaveEnabled        Boolean         @default(true)

  organization  Organization? @relation(fields: [organizationId], references: [id])
  promoter      PromoterProfile @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  
  ticketLots    TicketLot[]
  ticketTypes   TicketType[]
  seatMaps      SeatMap[]
  inventoryHolds InventoryHold[]
  seatHolds      SeatHold[]
  seats         Seat[]
  orders        Order[]
  tickets       Ticket[]
  checkinLogs   CheckinLog[]
  teamMembers   EventTeamMember[]
  coupons       Coupon[]
  assets        EventAsset[]
  trackingLinks TrackingLink[]
  artists       EventArtist[]
  ticketAlerts  EventTicketAlert[]
  favorites     EventFavorite[]

  @@index([slug])
  @@index([status])
  @@index([category])
  @@index([promoterId])
  @@index([organizationId])
}

model EventFavorite {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@index([eventId])
  @@map("event_favorites")
}

enum TicketAlertStatus {
  PENDING
  NOTIFIED
  UNSUBSCRIBED
}

model EventTicketAlert {
  id               String            @id @default(uuid())
  eventId          String
  email            String            @db.VarChar(320)
  name             String?           @db.VarChar(128)
  userId           String?
  status           TicketAlertStatus @default(PENDING)
  notifiedAt       DateTime?
  unsubscribeToken String            @unique @default(uuid())
  createdAt        DateTime          @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([eventId, email])
  @@index([eventId, status])
  @@index([status])
  @@map("event_ticket_alerts")
}

model TicketLot {
  id            String   @id @default(uuid())
  eventId       String
  name          String
  description   String?
  priceCents    Int
  currency      String   @default("EUR")
  quantityTotal Int
  quantitySold  Int      @default(0)
  saleStartAt   DateTime
  saleEndAt     DateTime
  isActive      Boolean  @default(true)
  
  // -- NEW ADVANCED TICKETING FIELDS --
  ticketTypeId  String?
  capacity      Int             @default(0)
  soldCount     Int             @default(0)
  startsAt      DateTime?
  endsAt        DateTime?
  status        TicketLotStatus @default(ACTIVE)
  perUserLimit  Int?

  createdAt     DateTime @default(now())
  
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType    TicketType? @relation(fields: [ticketTypeId], references: [id], onDelete: SetNull)
  orderItems     OrderItem[]
  tickets       Ticket[]
  holds         InventoryHold[]
  
  @@index([eventId])
  @@index([ticketTypeId])
}

// --- ADVANCED TICKETING MODELS ---

model TicketType {
  id           String           @id @default(uuid())
  eventId      String
  name         String
  description  String?
  status       TicketTypeStatus @default(ACTIVE)
  perUserLimit Int?
  requiresSeat Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt @default(now())

  event        Event            @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketLots   TicketLot[]
  seats        Seat[]
  artist       EventArtist?

  @@index([eventId])
}

model EventArtist {
  id            String   @id @default(uuid())
  eventId       String
  name          String
  slug          String
  imageUrl      String?  @db.VarChar(2048)
  bio           String?  @db.Text
  performanceAt DateTime
  venue         String?
  locationUrl   String?  @db.VarChar(2048) // Link Google Maps (substitui mapa por morada)
  sortOrder     Int      @default(0)
  badgeLabel    String?
  isPublished   Boolean  @default(true)
  ticketTypeId  String   @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt @default(now())

  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType  TicketType @relation(fields: [ticketTypeId], references: [id], onDelete: Restrict)

  @@unique([eventId, slug])
  @@index([eventId])
  @@index([performanceAt])
}

model InventoryHold {
  id          String     @id @default(uuid())
  eventId     String
  ticketLotId String
  userId      String?    
  qty         Int
  expiresAt   DateTime
  status      HoldStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())

  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketLot   TicketLot  @relation(fields: [ticketLotId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([ticketLotId])
  @@index([expiresAt])
  @@index([ticketLotId, status, expiresAt])
}

model SeatMap {
  id          String      @id @default(uuid())
  eventId     String
  name        String
  type        SeatMapType @default(THEATER)
  version     Int         @default(1)
  publishedAt DateTime?
  configJson  Json?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt @default(now())

  event       Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  seats       Seat[]

  @@index([eventId])
}

model Seat {
  id           String     @id @default(uuid())
  seatMapId    String
  eventId      String
  ticketTypeId String?
  section      String
  row          String
  number       String
  label        String?
  status       SeatStatus @default(AVAILABLE)

  seatMap      SeatMap    @relation(fields: [seatMapId], references: [id], onDelete: Cascade)
  event        Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  ticketType   TicketType? @relation(fields: [ticketTypeId], references: [id])
  holds        SeatHold[]
  tickets      Ticket[]

  @@unique([seatMapId, section, row, number])
  @@index([eventId])
  @@index([ticketTypeId])
}

model SeatHold {
  id        String     @id @default(uuid())
  seatId    String
  eventId   String
  userId    String?
  expiresAt DateTime
  status    HoldStatus @default(ACTIVE)
  createdAt DateTime   @default(now())

  seat      Seat       @relation(fields: [seatId], references: [id], onDelete: Cascade)
  event     Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([seatId])
  @@index([eventId])
  @@index([expiresAt])
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  eventId         String
  totalCents      Int
  serviceFeeCents Int         @default(0)
  feePaidBy       FeePaidBy?
  currency        String      @default("EUR")
  status          OrderStatus @default(PENDING)
  paymentProvider String?
  paymentRef      String?
  buyerName       String?
  buyerEmail      String?
  buyerPhone      String?
  source          OrderSource @default(ONLINE)
  paidAt          DateTime?
  idempotencyKey  String?     @unique
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt @default(now())

  user            User           @relation(fields: [userId], references: [id])
  event           Event          @relation(fields: [eventId], references: [id])
  items           OrderItem[]
  tickets         Ticket[]
  payments        Payment[]
  manualPayment   ManualPayment?
  couponCommission CouponCommission?
  financialBreakdown OrderFinancialBreakdown?
  ledgerTransactions LedgerTransaction[]
  refunds         Refund[]
  chargebacks     Chargeback[]

  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@index([paymentRef])
}

model Payment {
  id                String      @id @default(uuid())
  orderId           String
  provider          String      // e.g "STRIPE", "EUPAGO"
  method            String      // e.g "MBWAY", "MULTIBANCO", "CREDIT_CARD", "APPLE_PAY"
  providerReference String?     @unique
  status            String      // "PENDING", "PROCESSING", "SUCCEEDED", "FAILED", "CANCELED"
  amountCents       Int
  currency          String      @default("EUR")
  rawResponse       Json?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt @default(now())

  // Relations
  order             Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  chargebacks       Chargeback[]

  @@index([orderId])
  @@index([provider, providerReference])
  @@index([status])
}

model OrderItem {
  id          String    @id @default(uuid())
  orderId     String
  ticketLotId String
  quantity    Int
  unitPriceCents Int
  
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketLot   TicketLot @relation(fields: [ticketLotId], references: [id])
  
  @@index([orderId])
}

model Ticket {
  id          String   @id @default(uuid())
  orderId     String
  eventId     String
  userId      String
  ticketLotId String
  seatId      String?
  code        String   @unique
  qrPayload   String   @db.Text
  status      TicketStatus @default(VALID)
  
  checkedInAt DateTime?
  checkedInByUserId String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())
  
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event         Event        @relation(fields: [eventId], references: [id])
  user          User         @relation(fields: [userId], references: [id])
  ticketLot     TicketLot    @relation(fields: [ticketLotId], references: [id])
  seat          Seat?        @relation(fields: [seatId], references: [id], onDelete: SetNull)
  checkinLogs   CheckinLog[]
  transferFrom  TransferLog?  @relation("TransferFrom")
  transferTo    TransferLog?  @relation("TransferTo")
  renderSnapshot TicketRenderSnapshot?
  
  @@index([orderId])
  @@index([eventId])
  @@index([userId])
  @@index([ticketLotId])
  @@index([code])
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
  REFUNDED
}

enum EmailJobType {
  VERIFY_EMAIL
  ORG_INVITE
  PURCHASE_CONFIRMATION
  EVENT_REMINDER_24H
  POST_EVENT_THANKYOU
  PROMOTER_DAILY_REPORT
  TICKETS_AVAILABLE
}

model EmailJobLog {
  id             String       @id @default(uuid())
  type           EmailJobType
  toEmail        String
  templateId     String
  payloadJson    Json
  status         String       // "QUEUED" | "SENT" | "FAILED"
  error          String?      @db.Text
  idempotencyKey String       @unique
  createdAt      DateTime     @default(now())
  sentAt         DateTime?
  
  @@index([status])
  @@index([idempotencyKey])
}

model EmailLog {
  id                String    @id @default(uuid())
  to                String
  subject           String
  template          String?
  type              String?
  status            String    @default("PENDING")
  sentAt            DateTime?
  error             String?
  retryCount        Int       @default(0)
  providerMessageId String?
  relatedOrderId    String?
  relatedTicketId   String?
  relatedUserId     String?
  ipAddress         String?   @db.VarChar(45)
  meta              Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([to])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  metaJson       Json?
  ip             String?  @db.VarChar(45)
  userAgent      String?  @db.VarChar(512)
  createdAt      DateTime @default(now())
  
  organization   Organization? @relation(fields: [organizationId], references: [id])
  
  @@index([actorUserId])
  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

model Invite {
  id             String       @id @default(uuid())
  token          String       @unique // Hashed token
  email          String
  organizationId String
  role           MemberRole
  status         InviteStatus @default(PENDING)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  acceptedAt     DateTime?
  
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@index([token])
  @@index([email])
}

// --- FRAUD & SECURITY ---

model FraudSignal {
  id          String   @id @default(uuid())
  userId      String?
  orderId     String?
  ticketId    String?
  type        String   // "multi_account", "card_velocity", "ip_velocity"
  severity    String   // "low", "medium", "high", "critical"
  score       Int      // 0-100
  metadata    Json?
  createdAt   DateTime @default(now())
  
  user        User?    @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

model QrSigningKey {
  id        String   @id @default(uuid())
  keyId     String   @unique // The "kid" used in JWT/HMAC headers
  keySecret String   // The actual secret string
  active    Boolean  @default(true) // If false, new tickets won't be signed with it, but we may still validate it
  createdAt DateTime @default(now())
  
  @@index([active])
}

enum Role {
  USER
  ADMIN
  FINANCE_MANAGER
  SUPPORT_AGENT
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ENDED
}

enum EventLayoutMode {
  STANDARD
  ARTISTS
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED
  REFUNDED
  PENDING_MANUAL
  VOIDED
}

enum OrderSource {
  ONLINE
  MANUAL
}

enum ManualPaymentMethod {
  MBWAY
  CASH
  BANK
  OTHER
}

model ManualPayment {
  id               String              @id @default(uuid())
  orderId          String              @unique
  method           ManualPaymentMethod
  reference        String?
  notes            String?             @db.Text
  customerName     String?
  customerEmail    String?
  customerPhone    String?
  receivedByUserId String
  createdAt        DateTime            @default(now())

  order      Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  receivedBy User  @relation(fields: [receivedByUserId], references: [id])

  @@index([receivedByUserId])
}

enum EventTeamRole {
  ADMIN
  ORGANIZER
  MANAGER
  STAFF
  VIEWER
}

enum EventTeamPermission {
  CREATE_EVENTS
  SELL_TICKETS
  VALIDATE_ENTRIES
  VIEW_REPORTS
  MANAGE_TEAMS
}

model CheckinLog {
  id              String   @id @default(uuid())
  ticketId        String
  eventId         String
  validatorUserId String
  deviceId        String?
  result          String   // "SUCCESS", "INVALID", "ALREADY_USED"
  scannedAt       DateTime @default(now())
  rawPayloadHash  String?
  offline         Boolean  @default(false)
  syncedAt        DateTime?
  
  ticket          Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  validator       User     @relation("ValidatorCheckins", fields: [validatorUserId], references: [id], onDelete: Restrict)
  
  @@index([ticketId])
  @@index([eventId])
  @@index([scannedAt])
  @@index([validatorUserId])
}

model TransferLog {
  id           String   @id @default(uuid())
  fromTicketId String   @unique
  toTicketId   String   @unique
  fromUserId   String
  toUserId     String
  toEmail      String
  createdAt    DateTime @default(now())
  
  fromTicket   Ticket   @relation("TransferFrom", fields: [fromTicketId], references: [id], onDelete: Restrict)
  toTicket     Ticket   @relation("TransferTo", fields: [toTicketId], references: [id], onDelete: Restrict)
  fromUser     User     @relation("TransferFromUser", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser       User     @relation("TransferToUser", fields: [toUserId], references: [id], onDelete: Restrict)
  
  @@index([fromUserId])
  @@index([toUserId])
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id               String             @id @default(uuid())
  organizationId   String
  eventId          String
  code           String              @unique
  discountType   CouponDiscountType
  discountValue  Int
  maxUses        Int?
  usedCount      Int                 @default(0)
  assignedMemberId String?
  commissionCents  Int?
  isActive       Boolean             @default(true)
  startsAt       DateTime
  endsAt         DateTime
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @default(now()) @updatedAt

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event          Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  assignedMember OrganizationMember? @relation(fields: [assignedMemberId], references: [id], onDelete: SetNull)
  commissions    CouponCommission[]

  @@index([organizationId])
  @@index([eventId])
  @@index([code])
  @@index([assignedMemberId])
}

model CouponCommission {
  id          String   @id @default(uuid())
  couponId    String
  orderId     String   @unique
  memberId    String
  amountCents Int
  createdAt   DateTime @default(now())

  coupon Coupon             @relation(fields: [couponId], references: [id], onDelete: Cascade)
  order  Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  member OrganizationMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([memberId])
  @@index([createdAt])
}

model EventAsset {
  id          String   @id @default(uuid())
  eventId     String
  filename    String
  name        String?
  url         String
  mimeType    String
  size        Int
  createdAt   DateTime @default(now())
  
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  @@index([eventId])
}

model EventTeamMember {
  id          String            @id @default(uuid())
  eventId     String
  userId      String
  role        EventTeamRole     @default(STAFF)
  isActive    Boolean           @default(true)
  isVolunteer Boolean           @default(false)
  notes       String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt
  lastAccessAt DateTime?
  
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions EventTeamMemberPermission[]
  
  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model EventTeamMemberPermission {
  id          String              @id @default(uuid())
  memberId    String
  permission  EventTeamPermission
  
  member      EventTeamMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  @@unique([memberId, permission])
  @@index([memberId])
}

model TrackingLink {
  id        String   @id @default(uuid())
  eventId   String
  code      String
  label     String?
  clicks    Int      @default(0)
  conversions Int    @default(0)
  createdAt DateTime @default(now())
  
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  @@unique([eventId, code])
  @@index([eventId])
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model Payout {
  id             String       @id @default(uuid())
  organizationId String?
  promoterId     String?      // Legacy
  amountCents    Int
  currency       String       @default("EUR")
  status         PayoutStatus @default(PENDING)
  periodStart    DateTime?
  periodEnd      DateTime?
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
  
  organization   Organization? @relation(fields: [organizationId], references: [id])
  promoter       PromoterProfile? @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  
  @@index([organizationId])
  @@index([promoterId])
  @@index([status])
}

// --- FINANCIAL SYSTEM (Ledger-based) ---

enum WalletType {
  PLATFORM
  PROMOTER
  RESERVE
}

enum BalanceBucket {
  PENDING
  AVAILABLE
  WITHDRAWN
}

enum LedgerTransactionType {
  ORDER_PAYMENT
  TICKET_SALE
  SERVICE_FEE
  PAYMENT_GATEWAY_FEE
  COMMISSION
  REFUND
  WITHDRAWAL
  WITHDRAWAL_FEE
  RESERVE_ALLOCATION
  RESERVE_HOLD
  RESERVE_RELEASE
  BALANCE_RELEASE
  CHARGEBACK
  ADJUSTMENT
  MANUAL_ADJUSTMENT
  FEE
  PAYOUT
  PAYOUT_REVERSAL
}

enum LedgerTransactionStatus {
  PENDING
  COMPLETED
  REVERSED
  FAILED
}

enum LedgerEntryDirection {
  CREDIT
  DEBIT
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  PROCESSING
  PAID
  REJECTED
}

enum RefundStatus {
  PENDING
  APPROVED
  REJECTED
  PROCESSING
  COMPLETED
  FAILED
}

enum ChargebackStatus {
  PENDING
  OPEN
  WON
  LOST
  CLOSED
}

enum PaymentProviderKind {
  STRIPE
  EUPAGO
  MBWAY
  MULTIBANCO
  PAYPAL
  MANUAL
}

enum ServiceFeeType {
  PERCENTAGE
  FIXED
}

enum GlobalPricingMode {
  FORMULA
  TIERED
}

enum FeeRounding {
  NONE
  END_49
  END_99
  END_49_99
}

enum FeePaidBy {
  BUYER
  ORGANIZER
}

enum OrgPricingMode {
  GLOBAL
  CUSTOM
}

enum SettlementFrequency {
  DAILY
  WEEKLY
  BIWEEKLY
  MONTHLY
  MANUAL
}

enum FeeCampaignDiscountType {
  PERCENT_OFF_FEE
  FIXED_FEE_OVERRIDE
  ZERO_FEE
}

enum WalletTransactionType {
  TICKET_SALE
  SERVICE_FEE
  PAYMENT_GATEWAY_FEE
  COMMISSION
  RESERVE_HOLD
  RESERVE_RELEASE
  REFUND
  WITHDRAWAL
  WITHDRAWAL_FEE
  CHARGEBACK
  MANUAL_ADJUSTMENT
  PAYOUT
  PAYOUT_REVERSAL
  BALANCE_RELEASE
}

model PaymentMethod {
  id             String   @id @default(uuid())
  name           String   @db.VarChar(64)
  code           String   @unique @db.VarChar(32)
  fixedFee       Decimal  @default(0) @db.Decimal(10, 4)
  percentageFee  Decimal  @default(0) @db.Decimal(5, 2)
  vatPercentage  Decimal  @default(23) @db.Decimal(5, 2)
  active         Boolean  @default(true)
  deletedAt      DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active])
  @@map("payment_methods")
}

model FinancialSettings {
  id                      String   @id @default("default")
  // Legacy (mantido para compatibilidade)
  buyerFeePercent         Decimal  @default(0) @db.Decimal(5, 2)
  buyerFeeFixedCents      Int      @default(0)
  platformCommissionPercent Decimal @default(5) @db.Decimal(5, 2)
  reserveFundPercent      Decimal  @default(5) @db.Decimal(5, 2)
  minWithdrawalCents      Int      @default(2000)
  pendingReleaseDays      Int      @default(3)
  autoApproveWithdrawals  Boolean  @default(false)
  currency                String   @default("EUR")
  // Enterprise
  serviceFeeType          ServiceFeeType @default(PERCENTAGE)
  serviceFeeValue         Decimal  @default(5) @db.Decimal(10, 4)
  dynamicServiceFee       Boolean  @default(true)
  minimumProfitPerOrderCents Int @default(100)
  chargebackProtectionEnabled Boolean @default(true)
  automaticPayoutsEnabled Boolean @default(false)
  defaultVatPercent       Decimal  @default(23) @db.Decimal(5, 2)
  // Financial Engine
  pricingMode             GlobalPricingMode @default(FORMULA)
  serviceFeeFixedCents    Int      @default(50)
  minimumServiceFeeCents  Int      @default(149)
  maximumServiceFeeCents  Int?
  operationalReserveCents Int      @default(20)
  roundingMode            FeeRounding @default(END_49_99)
  absorbPaymentFees       Boolean  @default(true)
  defaultFeePaidBy        FeePaidBy @default(BUYER)
  updatedAt               DateTime @updatedAt
  updatedByUserId         String?
}

model PromoterFinancialSettings {
  id                         String   @id @default(uuid())
  organizationId             String   @unique
  serviceFeeMode             ServiceFeeType?
  serviceFeeValue            Decimal? @db.Decimal(10, 4)
  reservePercentage          Decimal? @db.Decimal(5, 2)
  minimumProfitPerOrderCents Int?
  payoutDelayDays            Int?
  // Organizer financial profile
  pricingMode                OrgPricingMode @default(GLOBAL)
  customFixedFeeCents        Int?
  customPercentageFee        Decimal? @db.Decimal(5, 2)
  customMinimumFeeCents      Int?
  customMaximumFeeCents      Int?
  customOperationalReserveCents Int?
  feePaidBy                  FeePaidBy?
  settlementFrequency        SettlementFrequency @default(MANUAL)
  lastSettlementAt           DateTime?
  active                     Boolean  @default(true)
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
}

model CommissionTier {
  id             String   @id @default(uuid())
  minPriceCents  Int
  maxPriceCents  Int?
  fixedFeeCents  Int      @default(0)
  percentageFee  Decimal  @default(0) @db.Decimal(5, 2)
  active         Boolean  @default(true)
  sortOrder      Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([active, sortOrder])
  @@map("commission_tiers")
}

model FeeCampaign {
  id              String                  @id @default(uuid())
  name            String                  @db.VarChar(128)
  startDate       DateTime
  endDate         DateTime
  discountType    FeeCampaignDiscountType
  discountValue   Decimal                 @default(0) @db.Decimal(10, 4)
  organizationId  String?
  firstEventOnly  Boolean                 @default(false)
  active          Boolean                 @default(true)
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([active, startDate, endDate])
  @@index([organizationId])
  @@map("fee_campaigns")
}

model WalletTransaction {
  id                  String              @id @default(uuid())
  walletId            String
  ledgerTransactionId String?
  type                WalletTransactionType
  amountCents         Int
  balanceBucket       BalanceBucket
  balanceBeforeCents  Int
  balanceAfterCents   Int
  referenceType       String?             @db.VarChar(64)
  referenceId         String?             @db.VarChar(64)
  description         String?             @db.VarChar(512)
  metadata            Json?
  deletedAt           DateTime?
  createdAt           DateTime            @default(now())

  wallet            Wallet             @relation(fields: [walletId], references: [id], onDelete: Restrict)
  ledgerTransaction LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id], onDelete: SetNull)

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
  @@index([ledgerTransactionId])
  @@map("wallet_transactions")
}

enum FinanceCostCategoryType {
  GATEWAY_FEES
  INFRASTRUCTURE
  MARKETING
  HR
  EXTERNAL_SERVICES
  CHARGEBACKS
  REFUNDS
  OTHER
}

model FinanceCostCategory {
  id        String                  @id @default(uuid())
  name      String                  @db.VarChar(128)
  type      FinanceCostCategoryType
  active    Boolean                 @default(true)
  createdAt DateTime                @default(now())

  entries FinanceCostEntry[]

  @@index([type])
}

model FinanceCostEntry {
  id             String   @id @default(uuid())
  categoryId     String
  organizationId String?
  eventId        String?
  amountCents    Int
  currency       String   @default("EUR")
  description    String?  @db.VarChar(512)
  recordedAt     DateTime @default(now())
  deletedAt      DateTime?

  category     FinanceCostCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  organization Organization?       @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  @@index([categoryId])
  @@index([organizationId])
  @@index([eventId])
  @@index([recordedAt])
}

model Wallet {
  id             String     @id @default(uuid())
  code           String     @unique
  type           WalletType
  organizationId String?    @unique
  currency       String     @default("EUR")
  isActive       Boolean    @default(true)
  deletedAt      DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledgerEntries  LedgerEntry[]
  withdrawalRequests WithdrawalRequest[]
  walletTransactions WalletTransaction[]

  @@index([type])
  @@index([deletedAt])
}

model LedgerTransaction {
  id              String                  @id @default(uuid())
  type            LedgerTransactionType
  status          LedgerTransactionStatus @default(PENDING)
  idempotencyKey  String?                 @unique
  description     String?                 @db.VarChar(512)
  amountCents     Int
  currency        String                  @default("EUR")
  referenceType   String?                 @db.VarChar(64)
  referenceId     String?                 @db.VarChar(64)
  orderId         String?
  organizationId  String?
  paymentProvider PaymentProviderKind?
  metadata        Json?
  reversedById    String?                 @unique
  completedAt     DateTime?
  reversedAt      DateTime?
  balanceReleasedAt DateTime?
  deletedAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  order           Order?         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  organization    Organization?  @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  entries         LedgerEntry[]
  reversalOf      LedgerTransaction?  @relation("TransactionReversal", fields: [reversedById], references: [id], onDelete: SetNull)
  reversedTransaction LedgerTransaction? @relation("TransactionReversal")
  orderBreakdown  OrderFinancialBreakdown?
  withdrawal      WithdrawalRequest?
  refund          Refund?
  chargeback      Chargeback?
  auditLogs       FinancialAuditLog[]
  walletTransactions WalletTransaction[]

  @@index([type, status])
  @@index([orderId])
  @@index([organizationId])
  @@index([referenceType, referenceId])
  @@index([createdAt])
  @@index([deletedAt])
}

model LedgerEntry {
  id            String               @id @default(uuid())
  transactionId String
  walletId      String
  direction     LedgerEntryDirection
  balanceBucket BalanceBucket
  amountCents   Int
  createdAt     DateTime             @default(now())

  transaction   LedgerTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  wallet        Wallet            @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([transactionId])
  @@index([walletId, balanceBucket])
  @@index([walletId, createdAt])
}

model OrderFinancialBreakdown {
  id                 String   @id @default(uuid())
  orderId            String   @unique
  ledgerTransactionId String  @unique
  subtotalCents      Int
  buyerFeeCents      Int
  serviceFeeCents    Int      @default(0)
  platformFeeCents   Int
  gatewayFeeCents    Int      @default(0)
  netPlatformProfitCents Int  @default(0)
  vatCents           Int      @default(0)
  reserveCents       Int
  promoterNetCents   Int
  totalCents         Int
  paymentMethodCode  String?  @db.VarChar(32)
  marginPercent      Decimal? @db.Decimal(5, 2)
  feePaidBy          FeePaidBy?
  operationalReserveCents Int @default(0)
  appliedCampaignId  String?  @db.VarChar(64)
  appliedTierId      String?  @db.VarChar(64)
  pricingModeUsed    String?  @db.VarChar(32)
  currency           String   @default("EUR")
  createdAt          DateTime @default(now())

  order              Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ledgerTransaction  LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)

  @@index([createdAt])
}

model WithdrawalRequest {
  id                  String           @id @default(uuid())
  walletId            String
  organizationId      String
  amountCents         Int
  currency            String           @default("EUR")
  status              WithdrawalStatus @default(PENDING)
  bankDetails         Json?
  iban                String?          @db.VarChar(34)
  ledgerTransactionId String?          @unique
  approvedByUserId    String?
  rejectedReason      String?          @db.VarChar(512)
  autoApproved        Boolean          @default(false)
  paidAt              DateTime?
  deletedAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  wallet              Wallet            @relation(fields: [walletId], references: [id], onDelete: Restrict)
  organization        Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ledgerTransaction   LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id], onDelete: SetNull)

  @@index([organizationId, status])
  @@index([status])
  @@index([createdAt])
  @@index([deletedAt])
}

model Refund {
  id                  String       @id @default(uuid())
  orderId             String
  ticketId            String?
  amountCents         Int
  currency            String       @default("EUR")
  reason              String?      @db.VarChar(512)
  status              RefundStatus @default(PENDING)
  ledgerTransactionId String?      @unique
  initiatedByUserId   String?
  processedAt         DateTime?
  deletedAt           DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  order               Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ledgerTransaction   LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@index([createdAt])
}

model Chargeback {
  id                  String           @id @default(uuid())
  orderId             String
  paymentId           String?
  amountCents         Int
  currency            String           @default("EUR")
  provider            PaymentProviderKind
  providerReference   String?          @db.VarChar(128)
  status              ChargebackStatus @default(PENDING)
  ledgerTransactionId String?          @unique
  reason              String?          @db.VarChar(512)
  evidence            Json?
  resolvedAt          DateTime?
  deletedAt           DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  order               Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payment             Payment?          @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  ledgerTransaction   LedgerTransaction? @relation(fields: [ledgerTransactionId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([status])
  @@index([provider, providerReference])
}

model FinancialAuditLog {
  id            String   @id @default(uuid())
  actorUserId   String?
  action        String   @db.VarChar(128)
  entityType    String   @db.VarChar(64)
  entityId      String?  @db.VarChar(64)
  transactionId String?
  beforeJson    Json?
  afterJson     Json?
  ip            String?  @db.VarChar(45)
  userAgent     String?  @db.VarChar(512)
  createdAt     DateTime @default(now())

  transaction   LedgerTransaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)

  @@index([actorUserId])
  @@index([entityType, entityId])
  @@index([transactionId])
  @@index([createdAt])
}

model PaymentProviderConfig {
  id            String              @id @default(uuid())
  provider      PaymentProviderKind @unique
  isEnabled     Boolean             @default(false)
  displayName   String              @db.VarChar(64)
  configJson    Json?
  webhookSecret String?             @db.VarChar(256)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(uuid())
  email     String   @unique
  source    String?  @default("homepage") @db.VarChar(64)
  createdAt DateTime @default(now())
}

model ContactMessage {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(120)
  email     String   @db.VarChar(255)
  subject   String   @db.VarChar(200)
  message   String   @db.Text
  status    String   @default("NEW") @db.VarChar(32)
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([status])
}

