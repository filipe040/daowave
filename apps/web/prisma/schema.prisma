generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                              String    @id @default(uuid())
  name                            String?
  avatarUrl                       String?   @db.VarChar(2048)
  email                           String    @unique
  passwordHash                    String
  role                            Role      @default(USER)
  emailVerified                   Boolean   @default(false)
  emailVerificationToken          String?   @unique
  emailVerificationTokenExpiresAt DateTime?
  createdAt                       DateTime  @default(now())
  // Password reset
  passwordResetToken              String?   @unique
  passwordResetTokenExpiresAt     DateTime?
  // Profile & preferences
  phone                           String?   @db.VarChar(32)
  emailVerifiedAt                 DateTime?
  lastLoginAt                     DateTime?
  termsAcceptedAt                 DateTime?
  termsVersion                    String?   @db.VarChar(32)
  marketingOptIn                  Boolean   @default(false)
  notifyEmail                     Boolean   @default(true)
  notifyEventReminders            Boolean   @default(true)
  notifyTransfers                 Boolean   @default(true)

  orders              Order[]
  tickets             Ticket[]
  promoterProfile      PromoterProfile? // Deprecated: migrar para OrganizationMember
  organizations        OrganizationMember[]
  validatorCheckins    CheckinLog[]      @relation("ValidatorCheckins")
  transferFromUser     TransferLog[]      @relation("TransferFromUser")
  transferToUser       TransferLog[]      @relation("TransferToUser")
  eventTeamMembers     EventTeamMember[] // Deprecated: migrar para OrganizationMember ou EventPermissions
  userSessions        UserSession[]
  fraudSignals        FraudSignal[]

  @@index([email])
  @@index([emailVerificationToken])
}

model UserSession {
  id         String    @id @default(uuid())
  userId     String
  ip         String?   @db.VarChar(45)
  userAgent  String?   @db.VarChar(512)
  createdAt  DateTime  @default(now())
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([revokedAt])
}

// --- ORGANIZATION & RBAC ---

enum OrganizationStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
}

enum MemberRole {
  OWNER
  MANAGER
  STAFF
  READ_ONLY
}

model Organization {
  id           String             @id @default(uuid())
  name         String
  slug         String             @unique
  vatNumber    String?
  contactEmail String?
  status       OrganizationStatus @default(PENDING)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  members      OrganizationMember[]
  events       Event[]
  payouts      Payout[]
  auditLogs    AuditLog[]

  @@index([slug])
  @@index([status])
}

model OrganizationMember {
  id             String       @id @default(uuid())
  organizationId String
  userId         String
  role           MemberRole   @default(STAFF)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId])
}

// Deprecated (Legacy Promoter)
model PromoterProfile {
  id           String          @id @default(uuid())
  userId       String          @unique
  brandName    String
  vatNumber    String?
  status       OrganizerStatus @default(PENDING)
  contactEmail String?
  score        Int?            // Score/reputação (admin); null = não calculado
  adminNotes   String?         @db.Text // Notas internas admin
  createdAt    DateTime        @default(now())
  
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  events      Event[]
  payouts     Payout[]
  
  @@index([userId])
}
enum OrganizerStatus {
  PENDING
  APPROVED
  REJECTED
}

// --- EVENTS ---

model Event {
  id          String      @id @default(uuid())
  organizationId String?  // New relation
  promoterId  String      // Legacy relation (keep for migration)
  title       String
  slug        String       @unique
  description String      @db.Text
  venue       String
  city        String
  startAt     DateTime
  endAt       DateTime
  coverImage  String?
  status      EventStatus  @default(DRAFT)
  archivedAt  DateTime?    // Data de arquivamento (null = não arquivado)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt @default(now())

  // Branding & Visual Protocol (Editor de Marca)
  primaryColor        String?  // Cor primária da marca do evento
  secondaryColor      String?  // Cor secundária da marca do evento
  logoUrl             String?  // URL do logo do evento
  bannerUrl           String?  // URL do banner/header do evento
  
  // Check-in configuration
  checkinMode           String?  @default("SINGLE") // SINGLE, MULTI
  checkinStartAt        DateTime? // Início da janela de check-in
  checkinEndAt          DateTime? // Fim da janela de check-in
  
  organization  Organization? @relation(fields: [organizationId], references: [id])
  promoter      PromoterProfile @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  
  ticketLots    TicketLot[]
  orders        Order[]
  tickets       Ticket[]
  checkinLogs   CheckinLog[]
  teamMembers   EventTeamMember[]
  coupons       Coupon[]
  assets        EventAsset[]
  trackingLinks TrackingLink[]
  
  @@index([slug])
  @@index([status])
  @@index([promoterId])
  @@index([organizationId])
}

model TicketLot {
  id            String   @id @default(uuid())
  eventId       String
  name          String
  description   String?
  priceCents    Int
  currency      String   @default("EUR")
  quantityTotal Int
  quantitySold  Int      @default(0)
  saleStartAt   DateTime
  saleEndAt     DateTime
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  orderItems     OrderItem[]
  tickets       Ticket[]
  
  @@index([eventId])
}

model Order {
  id              String      @id @default(uuid())
  userId          String
  eventId         String
  totalCents      Int
  currency        String      @default("EUR")
  status          OrderStatus @default(PENDING)
  paymentProvider String?
  paymentRef      String?
  buyerName       String?
  buyerEmail      String?
  buyerPhone      String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt @default(now())

  user   User   @relation(fields: [userId], references: [id])
  event  Event  @relation(fields: [eventId], references: [id])
  items   OrderItem[]
  tickets Ticket[]

  @@index([userId])
  @@index([eventId])
  @@index([status])
  @@index([paymentRef])
}

model OrderItem {
  id          String    @id @default(uuid())
  orderId     String
  ticketLotId String
  quantity    Int
  unitPriceCents Int
  
  order       Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  ticketLot   TicketLot @relation(fields: [ticketLotId], references: [id])
  
  @@index([orderId])
}

model Ticket {
  id          String   @id @default(uuid())
  orderId     String
  eventId     String
  userId      String
  ticketLotId String
  code        String   @unique
  qrPayload   String   @db.Text
  status      TicketStatus @default(VALID)
  
  checkedInAt DateTime?
  checkedInByUserId String?
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt @default(now())
  
  order         Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  event         Event        @relation(fields: [eventId], references: [id])
  user          User         @relation(fields: [userId], references: [id])
  ticketLot     TicketLot    @relation(fields: [ticketLotId], references: [id])
  checkinLogs   CheckinLog[]
  transferFrom  TransferLog?  @relation("TransferFrom")
  transferTo    TransferLog?  @relation("TransferTo")
  
  @@index([orderId])
  @@index([eventId])
  @@index([userId])
  @@index([ticketLotId])
  @@index([code])
}

enum TicketStatus {
  VALID
  USED
  CANCELLED
  REFUNDED
}

model EmailLog {
  id                String    @id @default(uuid())
  to                String
  subject           String
  template          String?
  type              String?
  status            String    @default("PENDING")
  sentAt            DateTime?
  error             String?
  retryCount        Int       @default(0)
  providerMessageId String?
  relatedOrderId    String?
  relatedTicketId   String?
  relatedUserId     String?
  meta              Json?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@index([to])
  @@index([status])
  @@index([createdAt])
}

model AuditLog {
  id             String   @id @default(uuid())
  organizationId String?
  actorUserId    String?
  action         String
  entityType     String
  entityId       String?
  metaJson       Json?
  createdAt      DateTime @default(now())
  
  organization   Organization? @relation(fields: [organizationId], references: [id])
  
  @@index([actorUserId])
  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

// --- FRAUD & SECURITY ---

model FraudSignal {
  id          String   @id @default(uuid())
  userId      String?
  orderId     String?
  ticketId    String?
  type        String   // "multi_account", "card_velocity", "ip_velocity"
  severity    String   // "low", "medium", "high", "critical"
  score       Int      // 0-100
  metadata    Json?
  createdAt   DateTime @default(now())
  
  user        User?    @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([type])
  @@index([createdAt])
}

enum Role {
  USER
  PROMOTER // Deprecated: usar OrganizationMember.role
  ADMIN    // Superadmin
  VALIDATOR // Deprecated: usar OrganizationMember
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  ENDED
}

enum OrderStatus {
  PENDING
  PAID
  CANCELED
  REFUNDED
}

enum EventTeamRole {
  ADMIN
  ORGANIZER
  MANAGER
  STAFF
  VIEWER
}

enum EventTeamPermission {
  CREATE_EVENTS
  SELL_TICKETS
  VALIDATE_ENTRIES
  VIEW_REPORTS
  MANAGE_TEAMS
}

model CheckinLog {
  id              String   @id @default(uuid())
  ticketId        String
  eventId         String
  validatorUserId String
  deviceId        String?
  result          String   // "SUCCESS", "INVALID", "ALREADY_USED"
  scannedAt       DateTime @default(now())
  rawPayloadHash  String?
  offline         Boolean  @default(false)
  syncedAt        DateTime?
  
  ticket          Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Restrict)
  validator       User     @relation("ValidatorCheckins", fields: [validatorUserId], references: [id], onDelete: Restrict)
  
  @@index([ticketId])
  @@index([eventId])
  @@index([scannedAt])
  @@index([validatorUserId])
}

model TransferLog {
  id           String   @id @default(uuid())
  fromTicketId String   @unique
  toTicketId   String   @unique
  fromUserId   String
  toUserId     String
  toEmail      String
  createdAt    DateTime @default(now())
  
  fromTicket   Ticket   @relation("TransferFrom", fields: [fromTicketId], references: [id], onDelete: Restrict)
  toTicket     Ticket   @relation("TransferTo", fields: [toTicketId], references: [id], onDelete: Restrict)
  fromUser     User     @relation("TransferFromUser", fields: [fromUserId], references: [id], onDelete: Restrict)
  toUser       User     @relation("TransferToUser", fields: [toUserId], references: [id], onDelete: Restrict)
  
  @@index([fromUserId])
  @@index([toUserId])
}

enum CouponDiscountType {
  PERCENTAGE
  FIXED
}

model Coupon {
  id            String              @id @default(uuid())
  eventId       String
  code          String              @unique
  discountType  CouponDiscountType
  discountValue Int
  maxUses       Int?
  usedCount     Int                 @default(0)
  isActive      Boolean             @default(true)
  startsAt      DateTime
  endsAt        DateTime
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @default(now()) @updatedAt
  
  event         Event               @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  @@index([eventId])
  @@index([code])
}

model EventAsset {
  id          String   @id @default(uuid())
  eventId     String
  filename    String
  name        String?
  url         String
  mimeType    String
  size        Int
  createdAt   DateTime @default(now())
  
  event       Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  @@index([eventId])
}

model EventTeamMember {
  id          String            @id @default(uuid())
  eventId     String
  userId      String
  role        EventTeamRole     @default(STAFF)
  isActive    Boolean           @default(true)
  isVolunteer Boolean           @default(false)
  notes       String?           @db.Text
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @default(now()) @updatedAt
  lastAccessAt DateTime?
  
  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  permissions EventTeamMemberPermission[]
  
  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
}

model EventTeamMemberPermission {
  id          String              @id @default(uuid())
  memberId    String
  permission  EventTeamPermission
  
  member      EventTeamMember     @relation(fields: [memberId], references: [id], onDelete: Cascade)
  
  @@unique([memberId, permission])
  @@index([memberId])
}

model TrackingLink {
  id        String   @id @default(uuid())
  eventId   String
  code      String
  label     String?
  clicks    Int      @default(0)
  conversions Int    @default(0)
  createdAt DateTime @default(now())
  
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  
  @@unique([eventId, code])
  @@index([eventId])
}

enum PayoutStatus {
  PENDING
  PROCESSING
  PAID
  FAILED
}

model Payout {
  id             String       @id @default(uuid())
  organizationId String?
  promoterId     String?      // Legacy
  amountCents    Int
  currency       String       @default("EUR")
  status         PayoutStatus @default(PENDING)
  periodStart    DateTime?
  periodEnd      DateTime?
  paidAt         DateTime?
  createdAt      DateTime     @default(now())
  
  organization   Organization? @relation(fields: [organizationId], references: [id])
  promoter       PromoterProfile? @relation(fields: [promoterId], references: [id], onDelete: Cascade)
  
  @@index([organizationId])
  @@index([promoterId])
  @@index([status])
}