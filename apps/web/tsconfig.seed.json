{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "paths": {
      "@prisma/client": [
        "../../node_modules/@prisma/client"
      ],
      "@/*": [
        "./*"
      ]
    },
    "outDir": "./dist-seed",
    "noEmit": true
  },
  "include": [
    "prisma/seed.ts",
    "scripts/seed-dao-wave-event.ts",
    "../../node_modules/@prisma/client/index.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}