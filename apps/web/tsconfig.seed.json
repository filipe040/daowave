{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": ".",
    "outDir": "./dist-seed",
    "noEmit": true
  },
  "include": ["prisma/seed.ts"],
  "exclude": ["node_modules"]
}
