# Database
DATABASE_URL="postgresql://username:password@localhost:5432/ticketing_db"
DIRECT_URL="postgresql://username:password@localhost:5432/ticketing_db"

# NextAuth
NEXTAUTH_SECRET="your-32-character-secret-key-here-12345678901234567890"
NEXTAUTH_URL="http://localhost:3000"

# QR Code Security
QR_SECRET="your-32-character-qr-secret-key-here-12345678901234567890"

# Application
NODE_ENV="development"
APP_NAME="LivePass"
APP_URL="http://localhost:3000"
SUPPORT_EMAIL="suporte@livepass.pt"

# Dados legais (páginas de privacidade, termos, RAL)
COMPANY_NAME="LivePass"
COMPANY_NIF=""
COMPANY_ADDRESS=""

# Redis (filas de email — obrigatório em produção)
REDIS_URL="redis://127.0.0.1:6379"

# Email Configuration (Choose one)
# Option 1: SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
EMAIL_FROM="EasyTicket <no-reply@example.com>"

# Option 2: Resend (recommended)
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
EMAIL_FROM="EasyTicket <no-reply@example.com>"

# Email Settings
EMAILS_ENABLED="true"
EMAILS_MODE="public_beta"
EMAIL_RATE_LIMIT_REGISTER_PER_HOUR="3"
EMAIL_RATE_LIMIT_FORGOT_PASSWORD_PER_HOUR="3"
EMAIL_RATE_LIMIT_RESEND_TICKET_PER_MIN="1"
EMAIL_RATE_LIMIT_RESEND_TICKET_PER_DAY="5"

# Storage (S3 Compatible)
STORAGE_ENDPOINT="https://s3.amazonaws.com"
STORAGE_ACCESS_KEY="your-access-key"
STORAGE_SECRET_KEY="your-secret-key"
STORAGE_BUCKET="your-bucket-name"

# Payments - Stripe
STRIPE_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
STRIPE_WEBHOOK_SECRET="whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Payments - Other providers (optional)
MBWAY_API_KEY="your-mbway-api-key"
MULTIBANCO_API_KEY="your-multibanco-api-key"
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"

# OAuth Providers (optional)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
APPLE_ID="your-apple-id"
APPLE_SECRET="your-apple-private-key"
APPLE_TEAM_ID="your-apple-team-id"
APPLE_KEY_ID="your-apple-key-id"

# Feature Flags
ENABLE_MOCK_PAYMENTS="true"
ENABLE_REAL_PAYMENTS="false"
ENABLE_REAL_EMAILS="false"
SHOW_BETA_BANNER="false"
BETA_CLOSED_REGISTRATION="false"

# Cron (obrigatório em produção — usar crontab do sistema, NÃO Vercel)
CRON_SECRET="generate-a-long-random-secret"
# URL que o crontab usa para chamar os jobs (PM2 local ou domínio público)
APP_BASE_URL="http://127.0.0.1:3000"

# Stripe (checkout real quando ENABLE_REAL_PAYMENTS=true)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# Security
RATE_LIMIT_REQUESTS_PER_MINUTE="60"
CORS_ORIGINS="http://localhost:3000"

# Observability (optional)
SENTRY_DSN="https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@sentry.io/xxxxxxx"
SENTRY_ENV="development"

# Public Variables (these go in .env.local)
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SHOW_BETA_BANNER="false"
